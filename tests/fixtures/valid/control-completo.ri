programa controlCompleto
areas
  ciudad: AreaC(1,1,100,100)
robots
  robot robot1
  variables
    activo: boolean
  comenzar
    activo:=V
    si activo
      comenzar
        repetir 2
          mover
      fin
    sino
      derecha
  fin
variables
  Rinfo: robot1
comenzar
  AsignarArea(Rinfo,ciudad)
  Iniciar(Rinfo,1,1)
fin
